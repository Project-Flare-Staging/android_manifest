  <project path="system/memory/lmkd" name="android_system_memory_lmkd" remote="flare" />
  <project path="system/update_engine" name="android_system_update_engine" remote="flare" />
  <project path="vendor/aospa" name="android_vendor_aospa" remote="flare" />
