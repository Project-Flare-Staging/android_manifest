  </project>
  <project path="device/flare/sepolicy/common" name="android_device_flare_sepolicy" remote="flare" revision="16.0-common" />
  <project path="device/flare/sepolicy/legacy" name="android_device_flare_sepolicy" remote="flare" revision="16.0-legacy" />
  <project path="device/qcom/common" name="android_device_qcom_common" remote="flare" >
